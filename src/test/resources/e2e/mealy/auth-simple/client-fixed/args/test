state-fuzzer-client

# Tests the client-fixed scenario's endpoint.
# Defined with -D by the end-to-end tests:
#   scenario.dir   the scenario's directory
#   work.dir       the work directory, holding alphabet.xml and tests.txt

##### StateFuzzerConfig #####
-output
${work.dir}/output

##### LearnerConfig #####
-alphabet
${work.dir}/alphabet.xml

##### SULConfig #####
-responseWait
100
# the scenario directory stands for the implementation; without -cmd, no
# process is started
-processDir
${scenario.dir}

##### SULClientConfig #####
# required, but unused by the in-memory SUL
-port
4217

##### TestRunnerConfig #####
-test
${work.dir}/tests.txt
# each test runs 10 times, so that nondeterministic outputs show
-times
10
-testSpecification
${scenario.dir}/model.dot
