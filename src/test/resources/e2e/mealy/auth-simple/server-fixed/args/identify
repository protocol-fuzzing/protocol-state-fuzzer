state-fuzzer-server

# Identifies the server-fixed scenario's endpoint with the fingerprint of its protocol and role.
# Defined with -D by the end-to-end tests:
#   scenarios.dir    the directory of the Mealy scenarios
#   work.dir         the work directory, holding alphabet.xml
#   fingerprint.dir  the directory holding the learned models of each protocol and role,
#                    in <protocol>/<role>/<scenario>/, and their ADG, in <protocol>/<role>-adg.dot

##### StateFuzzerConfig #####
-output
${work.dir}/output

##### LearnerConfig #####
-alphabet
${work.dir}/alphabet.xml
-equivalenceAlgorithms
WP_METHOD
-depth
2

##### SULConfig #####
-responseWait
100
# the scenario directory stands for the implementation; without -cmd, no
# process is started
-processDir
${scenarios.dir}/auth-simple/server-fixed

##### SULServerConfig #####
# required, but unused by the in-memory SUL
-connect
localhost:4217

##### IdentifierConfig #####
-identify
${fingerprint.dir}/auth-simple/server-adg.dot
# the path of each identified model is appended to this one without a
# separator, hence the trailing /
-conformance
${fingerprint.dir}/auth-simple/server/
