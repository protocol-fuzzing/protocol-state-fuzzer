state-fuzzer-server

# Identifies the server-buggy-slow scenario's endpoint with the fingerprint of its protocol and role.
# Defined with -D by the end-to-end tests:
#   scenario.dir     the scenario's directory
#   work.dir         the work directory, holding alphabet.xml
#   models.dir       the directory with one subdirectory per learned model
#   adg.file         the ADG of the models

##### StateFuzzerConfig #####
-output
${work.dir}/output

##### LearnerConfig #####
-alphabet
${work.dir}/alphabet.xml
-equivalenceAlgorithms
WP_METHOD
-depth
2

##### SULConfig #####
-responseWait
200
# the scenario directory stands for the implementation; without -cmd, no
# process is started
-processDir
${scenario.dir}

##### SULServerConfig #####
# required, but unused by the in-memory SUL
-connect
localhost:4217

##### IdentifierConfig #####
-identify
${adg.file}
# the name of each identified model is appended to this path without a
# separator, hence the trailing /
-conformance
${models.dir}/
