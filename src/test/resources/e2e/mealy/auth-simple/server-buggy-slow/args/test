state-fuzzer-server

# Tests the server-buggy-slow scenario's endpoint.
# Defined with -D by the end-to-end tests:
#   scenarios.dir  the directory of the Mealy scenarios
#   work.dir       the work directory, holding alphabet.xml and tests.txt

##### StateFuzzerConfig #####
-output
${work.dir}/output

##### LearnerConfig #####
-alphabet
${work.dir}/alphabet.xml

##### SULConfig #####
-responseWait
200
# the scenario directory stands for the implementation; without -cmd, no
# process is started
-processDir
${scenarios.dir}/auth-simple/server-buggy-slow

##### SULServerConfig #####
# required, but unused by the in-memory SUL
-connect
localhost:4217

##### TestRunnerConfig #####
-test
${work.dir}/tests.txt
# each test runs 10 times, so that nondeterministic outputs show
-times
10
-testSpecification
${scenarios.dir}/auth-simple/server-buggy-slow/model.dot
