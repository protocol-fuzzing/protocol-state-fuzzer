state-fuzzer-client

# Tests the client-buggy scenario's endpoint; the RA test runner takes no test
# specification, so the tests check the outputs against model.xml.
# Defined with -D by the end-to-end tests:
#   scenarios.dir  the directory of the RA scenarios
#   work.dir       the work directory, holding alphabet.xml and tests.txt

##### StateFuzzerConfig #####
-output
${work.dir}/output

##### LearnerConfig #####
-alphabet
${work.dir}/alphabet.xml

##### SULConfig #####
-responseWait
100
# the scenario directory stands for the implementation; without -cmd, no
# process is started
-processDir
${scenarios.dir}/auth-simple/client-buggy

##### SULClientConfig #####
# required, but unused by the in-memory SUL
-port
4217

##### TestRunnerConfig #####
-test
${work.dir}/tests.txt
# each test runs 10 times, so that nondeterministic outputs show
-times
10
